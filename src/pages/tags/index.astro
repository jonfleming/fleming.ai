---
import Base from '../../layouts/Base.astro';
import { collectTags, getArticles, getProjects } from '../../lib/content';

const tags = collectTags(await getArticles(), await getProjects());
---

<Base title="Tags" description="Tags across Fleming AI articles and projects.">
	<main id="content" class="wrap">
		<div class="page-title">
			<h1>Tags</h1>
			<p>Tags are free-form labels in article and project frontmatter.</p>
		</div>
		<p class="tag-row">
			{tags.map((tag) => <a href={`/tags/${tag.slug}/`}>{tag.label}</a>)}
		</p>
	</main>
</Base>
