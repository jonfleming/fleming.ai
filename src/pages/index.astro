---
import ArticleList from '../components/ArticleList.astro';
import Base from '../layouts/Base.astro';
import { SITE_DESCRIPTION, SITE_TITLE, TOPICS } from '../consts';
import { getArticles, getProjects } from '../lib/content';

const articles = await getArticles();
const projects = await getProjects();
const featured = TOPICS.filter((topic) => topic.featured);
const leadProject = projects.find((project) => project.data.featured) ?? projects[0];
const leadLog = leadProject
	? [...leadProject.data.log].sort((a, b) => b.date.valueOf() - a.date.valueOf()).slice(0, 4)
	: [];
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<main id="content">
		<section class="hero wrap">
			<p class="kicker">A living laboratory</p>
			<h1>Fleming AI</h1>
			<p class="lede">Exploring practical AI, robotics, voice assistants and intelligent homes.</p>
			<p class="sublede">
				Building things with AI, Raspberry Pi, ESP32, Home Assistant and robots.
			</p>
		</section>

		<section class="section wrap">
			<h2>In the lab</h2>
			<div class="card-grid">
				{
					featured.map((topic) => (
						<a class="card" href={`/topics/${topic.slug}/`}>
							<h3>{topic.title}</h3>
							<p>{topic.description}</p>
						</a>
					))
				}
			</div>
		</section>

		{
			leadProject && (
				<section class="section wrap">
					<h2>Current project</h2>
					<a class="card" href={`/projects/${leadProject.id}/`}>
						<p class="kicker">{leadProject.data.status}</p>
						<h3>{leadProject.data.title}</h3>
						<p>{leadProject.data.description}</p>
					</a>
					{
						leadLog.length > 0 && (
							<ol class="log">
								{leadLog.map((entry) => (
									<li>
										<time datetime={entry.date.toISOString()}>
											{entry.date.toLocaleDateString('en-US', {
												month: 'short',
												year: 'numeric',
												timeZone: 'UTC',
											})}
										</time>
										<div>{entry.summary}</div>
									</li>
								))}
							</ol>
						)
					}
					<p><a href="/projects/">All projects</a></p>
				</section>
			)
		}

		<section class="section wrap">
			<h2>Articles</h2>
			<ArticleList articles={articles.slice(0, 5)} />
			<p><a href="/articles/">All articles</a></p>
		</section>
	</main>
</Base>
