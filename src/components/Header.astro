---
const path = Astro.url.pathname;
const links = [
	{ href: '/articles/', label: 'Articles' },
	{ href: '/projects/', label: 'Projects' },
	{ href: '/topics/', label: 'Topics' },
	{ href: '/about/', label: 'About' },
];

function current(href: string) {
	return path === href || path.startsWith(href) ? 'page' : undefined;
}
---

<header class="site-header">
	<a class="wordmark" href="/">Fleming <span>AI</span></a>
	<button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
		Menu
	</button>
	<nav id="site-nav" class="site-nav">
		{
			links.map((link) => (
				<a href={link.href} aria-current={current(link.href)}>
					{link.label}
				</a>
			))
		}
	</nav>
	<div class="header-tools">
		<a class="icon-link" href="/search/" aria-current={current('/search/')}>Search</a>
		<button class="theme-toggle" type="button" aria-label="Switch color theme">
			<span class="theme-label"></span>
		</button>
	</div>
</header>

<script>
	const toggle = document.querySelector('.nav-toggle');
	const nav = document.querySelector('#site-nav');
	toggle?.addEventListener('click', () => {
		const open = nav?.classList.toggle('is-open');
		toggle.setAttribute('aria-expanded', String(Boolean(open)));
	});
	nav?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => {
			// Hide after the click's navigation starts. Hiding the link during the
			// click event cancels the navigation.
			setTimeout(() => {
				nav.classList.remove('is-open');
				toggle?.setAttribute('aria-expanded', 'false');
			}, 0);
		});
	});

	const themeButton = document.querySelector('.theme-toggle');
	const themeLabel = themeButton?.querySelector('.theme-label');

	function paintThemeLabel() {
		if (!themeLabel) return;
		const dark = document.documentElement.dataset.theme === 'dark';
		themeLabel.textContent = dark ? 'Light' : 'Dark';
	}

	paintThemeLabel();
	themeButton?.addEventListener('click', () => {
		const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
		document.documentElement.dataset.theme = next;
		localStorage.setItem('theme', next);
		paintThemeLabel();
	});
</script>
