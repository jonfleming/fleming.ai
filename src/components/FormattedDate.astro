---
interface Props {
	date: Date;
	monthYear?: boolean;
}

const { date, monthYear = false } = Astro.props;
const formatted = date.toLocaleDateString('en-US', {
	year: 'numeric',
	month: 'short',
	day: monthYear ? undefined : 'numeric',
	timeZone: 'UTC',
});
---

<time datetime={date.toISOString()}>{formatted}</time>
